{
  "name": "pintig-web-application",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "description": "PINTIG React and TypeScript frontend prototype; preserved v27 design and workflows",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.mjs",
    "check": "tsc --noEmit && npm test",
    "start:local": "npm run build && node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "verify:production": "node scripts/verify-production.mjs",
    "format": "prettier --write src tests scripts/serve.mjs vite.config.ts playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
